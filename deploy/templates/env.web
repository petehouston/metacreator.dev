# MetaCreator.Dev — Next.js production environment.
#
# Generated once by deploy/scripts/provision.sh into
# __SHARED_DIR__/web/.env.production. Read at two different times, which is the
# thing to keep straight:
#
#   NEXT_PUBLIC_*  are inlined into the browser bundle AT BUILD TIME. Changing
#                  one requires a redeploy, not just a restart.
#   everything else is read by the running server, so a restart picks it up.
#
# systemd loads this file as an EnvironmentFile, which is not a shell: do not
# quote values, do not use ${...} interpolation, and keep one KEY=value a line.

# Seen by the browser. Same origin as the site itself, so an API call from the
# client is a same-origin request carrying the session cookie automatically.
NEXT_PUBLIC_APP_URL=__APP_URL__
NEXT_PUBLIC_API_URL=__APP_URL__

# Server-only, and the counterpart to the two above. Server Components reach the
# API through nginx on loopback rather than over the public hostname: a request
# to https://__DOMAIN__ from the droplet would travel out to Cloudflare and back
# just to reach a socket two processes away, and would make page rendering
# depend on the edge being reachable.
#
# Note this is the *internal* origin (port __NGINX_INTERNAL_PORT__), which
# serves /api, /up and /storage and 404s everything else. deploy.sh temporarily
# overrides it to the build origin (port __NGINX_BUILDING_PORT__) while
# prerendering, so the build reads the API of the release it is building.
API_INTERNAL_URL=http://127.0.0.1:__NGINX_INTERNAL_PORT__

# Must match REVALIDATE_SECRET in the Laravel .env — it is the shared signature
# on on-demand ISR calls. Changing one without the other silently stops the
# blog from updating until a full rebuild.
REVALIDATE_SECRET=__REVALIDATE_SECRET__

NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production
