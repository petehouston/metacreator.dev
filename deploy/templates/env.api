# MetaCreator.Dev — Laravel production environment.
#
# Generated once by deploy/scripts/provision.sh into __SHARED_DIR__/api/.env and
# then NEVER touched again by any script. It is shared state: every release
# symlinks to this one file, so a deploy cannot lose it and a rollback cannot
# revert it. Edit it in place on the server:
#
#   deploy/scripts/remote.sh edit-env-api
#
# After editing, run `deploy/scripts/remote.sh reload` so the cached config is
# rebuilt — Laravel reads config:cache in production, not this file directly.

APP_NAME=MetaCreator
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=__APP_URL__
APP_TIMEZONE=UTC
FRONTEND_URL=__APP_URL__

# `daily` rather than `stack`: one file per day under storage/logs, pruned by
# the retention below, so a runaway error cannot fill the disk this droplet
# shares with ten other sites.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=__DB_HOST__
DB_PORT=__DB_PORT__
DB_DATABASE=__DB_NAME__
DB_USERNAME=__DB_USER__
DB_PASSWORD=__DB_PASSWORD__

# Redis is shared with the other sites on this droplet. Three things keep this
# app's keys separate from theirs: dedicated database numbers (8 and 9, both
# empty when this was provisioned), a key prefix, and a Horizon prefix. Never
# run `redis-cli flushall` on this box — it would wipe every site. Use
# `php artisan cache:clear`, which only removes this app's prefixed keys.
REDIS_CLIENT=phpredis
REDIS_HOST=__REDIS_HOST__
REDIS_PORT=__REDIS_PORT__
REDIS_DB=__REDIS_DB__
REDIS_CACHE_DB=__REDIS_CACHE_DB__
REDIS_PREFIX=__REDIS_PREFIX__

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=10080
# No leading dot: the cookie is for the apex only, and www redirects to it.
SESSION_DOMAIN=__DOMAIN__
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

HORIZON_PREFIX=__HORIZON_PREFIX__

# The front end is same-origin, so this list is really just belt and braces —
# there is no cross-site request for Sanctum to make stateful.
SANCTUM_STATEFUL_DOMAINS=__DOMAIN__,__WWW_DOMAIN__

# ── Mail ─────────────────────────────────────────────────────────────────────
# `log` writes every outbound message to storage/logs instead of sending it.
# Nothing is delivered — magic-link sign-in, email verification and password
# reset will not reach a real inbox until this is changed. That is a deliberate
# launch default: it cannot bounce, cannot be marked spam, and cannot damage a
# sending domain's reputation before SPF/DKIM exist.
#
# To go live, swap MAIL_MAILER to `smtp` or `mailgun`, fill in the credentials,
# and run `deploy/scripts/remote.sh reload`.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@__DOMAIN__"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=

# ── Storage ──────────────────────────────────────────────────────────────────
# Uploads land in shared/api/storage/app/public and are served by nginx from the
# public/storage symlink. To move to DigitalOcean Spaces later, set
# FILESYSTEM_DISK=s3, fill in the AWS_* block, and copy the existing files up —
# nothing else in the application changes.
FILESYSTEM_DISK=public
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=sgp1
# AWS_BUCKET=
# AWS_ENDPOINT=https://sgp1.digitaloceanspaces.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Integrations ─────────────────────────────────────────────────────────────
# Stripe is specified but not implemented (docs/24). Leaving these blank is
# correct; the admin's payment settings screen stores its own credentials.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Google OAuth is blocked upstream on a Guzzle major-version conflict (docs/03).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Go compute service is not deployed: nothing in the Laravel application
# calls it today. If that changes, deploy it and point this at its loopback port.
# COMPUTE_URL=http://127.0.0.1:__COMPUTE_PORT__
COMPUTE_SHARED_SECRET=__COMPUTE_SECRET__

# On-demand ISR. Laravel calls the Next server directly on loopback, so a
# revalidation never leaves the droplet.
REVALIDATE_URL=http://127.0.0.1:__WEB_PORT__/api/revalidate
REVALIDATE_SECRET=__REVALIDATE_SECRET__

SENTRY_LARAVEL_DSN=
