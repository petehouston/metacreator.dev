memory_limit = 512M
max_execution_time = 120
upload_max_filesize = 128M
post_max_size = 128M
date.timezone = UTC
expose_php = Off

; Never stat files in production — the deploy restarts FPM, which is when new code
; should become visible, and only then.
opcache.enable = 1
opcache.validate_timestamps = 0
opcache.memory_consumption = 256
opcache.interned_strings_buffer = 32
opcache.max_accelerated_files = 30000
opcache.jit = tracing
opcache.jit_buffer_size = 128M

realpath_cache_size = 4096K
realpath_cache_ttl = 600

; Never reveal internals to a visitor; errors go to the log and to Sentry.
display_errors = Off
log_errors = On
error_log = /var/log/php/error.log
