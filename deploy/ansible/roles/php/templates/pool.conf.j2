[metacreator]
user = {{ deploy_user }}
group = {{ deploy_group }}
listen = 127.0.0.1:9000
listen.owner = {{ deploy_user }}
listen.group = {{ deploy_group }}

; Dynamic scales with load without pre-forking a fixed, wasteful pool.
pm = dynamic
pm.max_children = 40
pm.start_servers = 8
pm.min_spare_servers = 4
pm.max_spare_servers = 12
; Recycle workers periodically so a slow leak in any dependency cannot accumulate.
pm.max_requests = 500

request_terminate_timeout = 120s
catch_workers_output = yes
decorate_workers_output = no

php_admin_value[error_log] = /var/log/php/fpm-metacreator.log
php_admin_flag[log_errors] = on
