# Local Docker Compose settings. Copy to `.env` — `make setup` does this for you.
# Application secrets live in apps/api/.env and apps/web/.env.local, not here.

# ── Host port mappings (change if something already uses these) ───────────────
WEB_PORT=3000
API_PORT=8080
COMPUTE_PORT=8090
MYSQL_PORT=3307
REDIS_PORT=6380
MAILPIT_UI_PORT=8025
MINIO_API_PORT=9000
MINIO_UI_PORT=9001

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=metacreator
MYSQL_USER=metacreator
MYSQL_PASSWORD=secret

# ── MinIO (stands in for DigitalOcean Spaces locally) ─────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MEDIA_BUCKET=metacreator-media

# ── Shared secrets (local only — never reuse these anywhere real) ─────────────
REVALIDATE_SECRET=local-revalidate-secret
COMPUTE_SHARED_SECRET=local-compute-secret
