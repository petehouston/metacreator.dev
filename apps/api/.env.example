APP_NAME=MetaCreator
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=metacreator
DB_USERNAME=metacreator
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_DOMAIN=localhost
QUEUE_CONNECTION=redis

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@metacreator.dev"
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=
MAILGUN_SECRET=

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=metacreator-media
AWS_ENDPOINT=http://minio:9000
# The public address of the bucket: the frontend proxies /media to MinIO so that
# one URL works for the browser and for next/image's server-side fetch.
AWS_URL=http://localhost:3000/media
AWS_USE_PATH_STYLE_ENDPOINT=true

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

COMPUTE_URL=http://compute:8090
COMPUTE_SHARED_SECRET=local-compute-secret

REVALIDATE_URL=http://web:3000/api/revalidate
REVALIDATE_SECRET=local-revalidate-secret

SENTRY_LARAVEL_DSN=
